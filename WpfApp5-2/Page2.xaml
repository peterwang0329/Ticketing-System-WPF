                                </StackPanel>
                            </StackPanel>
                        </Viewbox>
                    </GroupBox>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Margin="0 15 10 0">
                    <Label Content="Total:" FontSize="28" VerticalContentAlignment="Center" FontFamily="UD Digi Kyokasho NK-B"/>
                    <Label Content="0" x:Name="Total" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontSize="28" Width="120" FontFamily="UD Digi Kyokasho NK-B"/>
                    <Label Content="元" FontSize="28" VerticalContentAlignment="Center" FontFamily="UD Digi Kyokasho NK-B"/>
                    <Button Height="50" Width="80" Content="返回" x:Name="back" FontSize="18" Margin="10 0 0 0" FontFamily="UD Digi Kyokasho NK-B" Click="Button_Click"></Button>
                    <Button Height="50" Width="100" Content="當前訂單" x:Name="check" FontSize="18" Margin="10 0 0 0" FontFamily="UD Digi Kyokasho NK-B" Click="Button_Click"></Button>
                    <Button Height="50" Width="100" Content="加入訂單" x:Name="add" FontSize="18" Margin="10 0 0 0" FontFamily="UD Digi Kyokasho NK-B" Click="Button_Click"></Button>
                </StackPanel>
            </StackPanel>
        <Image x:Name="image" Height="730" Width="483" Stretch="Fill"/>
        </StackPanel>
    </Grid>
