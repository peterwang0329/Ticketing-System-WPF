                                        <Button Height="30" Width="30" Content="-" x:Name="minus_food9" IsEnabled="False" Click="Food_Click" FontWeight="Bold"></Button>
                                        <Label Height="30" Width="40"  Content="0" x:Name="food_number9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Kristen ITC"></Label>
                                        <Button Height="30" Width="30" Content="+" x:Name="plus_food9" Click="Food_Click" FontWeight="Bold"></Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Height="30" Width="30" Content="-" x:Name="minus_food10" IsEnabled="False" Click="Food_Click" FontWeight="Bold"></Button>
                                        <Label Height="30" Width="40"  Content="0" x:Name="food_number10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Kristen ITC"></Label>
                                        <Button Height="30" Width="30" Content="+" x:Name="plus_food10" Click="Food_Click" FontWeight="Bold"></Button>
