<Window x:Class="WpfApp5_2.Fin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5_2"
        mc:Ignorable="d"
        Title="" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFFFCC7C" Offset="0.008"/>
            <GradientStop Color="#FF88CAD2" Offset="0.84"/>
            <GradientStop Color="#FFC3C88B" Offset="0.237"/>
            <GradientStop Color="#FF8EE399" Offset="0.731"/>
            <GradientStop Color="#FFA5DA98" Offset="0.492"/>
            <GradientStop Color="#FF78BCCB" Offset="0.918"/>
            <GradientStop Color="#FF5FBBCF" Offset="1"/>
            <GradientStop Color="#FFDCC683" Offset="0.125"/>
            <GradientStop Color="#FFC0DCA4" Offset="0.351"/>
            <GradientStop Color="#FF99DE98" Offset="0.644"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Button x:Name="free" Width="20" Height="20" Margin="0,0,750,375" Click="free_Click" Background="{x:Null}" Foreground="{x:Null}">
            <Button.BorderBrush>
                <SolidColorBrush Color="#FF707070" Opacity="0.001"/>
            </Button.BorderBrush>
        </Button>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="結帳成功!" FontSize="36" HorizontalContentAlignment="Center" FontFamily="Yu Mincho Demibold">
                <Label.Foreground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="Black" Offset="1"/>
                        <GradientStop Color="Gray" Offset="0.503"/>
                    </LinearGradientBrush>
                </Label.Foreground>
            </Label>
            <Label Content="感謝您的蒞臨" FontSize="36" HorizontalContentAlignment="Center" FontFamily="Yu Mincho Demibold">
                <Label.Foreground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black" Offset="1"/>
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="#FF787878" Offset="0.503"/>
                    </LinearGradientBrush>
                </Label.Foreground>
            </Label>
        </StackPanel>
    </Grid>
</Window>
