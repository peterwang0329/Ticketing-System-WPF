<Page x:Class="WpfApp5_2.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp5_2"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="700"
      Title="主頁面" Background="White" Loaded="Page_Loaded">

    <Grid>
        <StackPanel Background="#FFF36666">
            <Grid>
                <Image Name="image1" Width="700" Height="240" Stretch="Fill" />
                <Label x:Name="left" Content="◀" Height="240" Width="50" Foreground="#AA101010"
                Background="#05FFFFFF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                HorizontalAlignment="Center" Margin="0 0 650 0" MouseUp="Textblock_MouseUp" MouseEnter="Label_MouseEnter" MouseLeave="Label_MouseLeave"/>
                <Label x:Name="right" Content="▶" Height="240" Width="50" Foreground="#A0101010"
                Background="#05FFFFFF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                HorizontalAlignment="Center" Margin="650 0 0 0" MouseUp="Textblock_MouseUp" MouseEnter="Label_MouseEnter" MouseLeave="Label_MouseLeave"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 40 0 0">
                <StackPanel VerticalAlignment="Center" Margin="0 0 25 0">
                    <GroupBox Header="訂票" FontSize="18" Background="#FFC0BDBD" Width="300" Height="220" FontFamily="UD Digi Kyokasho NK-B">
                        <GroupBox.Foreground>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF3D0B0B"/>
                                <GradientStop Color="#FFD67F7F" Offset="1"/>
                            </LinearGradientBrush>
                        </GroupBox.Foreground>
                        <StackPanel>
                            <StackPanel Margin="0 15 0 0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Label Content="🎥" FontSize="18"/>
                                <ComboBox x:Name="Movie" Height="35" Width="220" MaxDropDownHeight="195"
                                  FontSize="18" VerticalContentAlignment="Center" SelectionChanged="Movie_SelectionChanged" FontFamily="UD Digi Kyokasho NP-R">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" MinWidth="100" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="MinWidth" Value="100" />
                                            <Setter Property="MaxWidth" Value="200" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 0">
                                <Label Content="📆" FontSize="18"/>
                                <ComboBox x:Name="Date" Height="35" Width="220" MaxDropDownHeight="195"
                                  FontSize="18" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 0">
                                <Label Content="🕒" FontSize="18"/>
                                <ComboBox x:Name="Time" Height="35" Width="220" MaxDropDownHeight="130"
                                  FontSize="18" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="get" Content="前往訂票" Width="100" Height="40" Margin="5 8 0 0" Click="Button_Click"/>
                                <Button x:Name="check" Content="確認訂單" Width="100" Height="40" Margin="5 8 0 0" Click="Button_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Label Content="(" FontSize="36" Margin="0 0 -10 0" VerticalAlignment="Center" FontFamily="BIZ UDGothic">
                            <Label.Foreground>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FF4D4444" Offset="0"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                    <GradientStop Color="#FF585858" Offset="0.718"/>
                                </LinearGradientBrush>
                            </Label.Foreground>
                        </Label>
                        <StackPanel>
                            <Label Content="請先點選您的電影和時間" FontSize="16" HorizontalAlignment="Center" FontFamily="BIZ UDGothic">
                                <Label.Foreground>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF594F4F" Offset="0.003"/>
                                        <GradientStop Color="Black" Offset="1"/>
                                        <GradientStop Color="#FF424242" Offset="0.718"/>
                                    </LinearGradientBrush>
                                </Label.Foreground>
                            </Label>
                            <Label Content="才可點擊&quot;前往訂票&quot;" FontSize="16" HorizontalAlignment="Center" FontFamily="BIZ UDGothic">
                                <Label.Foreground>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF594F4F" Offset="0.003"/>
                                        <GradientStop Color="Black" Offset="1"/>
                                        <GradientStop Color="#FF3F3F3F" Offset="0.718"/>
                                    </LinearGradientBrush>
                                </Label.Foreground>
                            </Label>
                        </StackPanel>
                        <Label Content=")" FontSize="36" Margin="-10 0 0 0" VerticalAlignment="Center" FontFamily="BIZ UDGothic">
                            <Label.Foreground>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FF594F4F" Offset="0.003"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                    <GradientStop Color="#FF4E4E4E" Offset="0.718"/>
                                </LinearGradientBrush>
                            </Label.Foreground>
                        </Label>
                    </StackPanel>
                </StackPanel>
                <Image Name="menu_show" Width="200" Height="300" Stretch="Fill"/>
            </StackPanel>
        </StackPanel>
        <Label Content="註1:電影時間會根據現在時間往後推7天,每天時間也不同    註2:結帳後有彩蛋喔(提示:視窗左上附近)" FontSize="12" Width="700" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Background="Black">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="White" Offset="1"/>
                    <GradientStop Color="Gray" Offset="0.505"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
    </Grid>
</Page>
